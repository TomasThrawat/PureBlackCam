<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.PureBlackCam" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/pure_black</item>
        <item name="android:statusBarColor">@color/pure_black</item>
        <item name="android:navigationBarColor">@color/pure_black</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="colorPrimary">@color/pure_black</item>
        <item name="colorPrimaryDark">@color/pure_black</item>
        <item name="colorAccent">@color/pure_white</item>
    </style>

    <style name="CamButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:textColor">@color/pure_white</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:padding">14dp</item>
        <item name="android:minWidth">64dp</item>
        <item name="android:gravity">center</item>
    </style>
</resources>
